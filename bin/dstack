#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
entry=${1-}
if [ "$#" -gt 0 ]; then
  shift
fi
case "$entry" in
  ctl) script="$root/skills/dstack-beads-core/scripts/dstackctl.py" ;;
  setup) script="$root/skills/dstack-beads-core/scripts/setup.py" ;;
  *)
    echo "usage: dstack {ctl|setup} [arguments...]" >&2
    exit 2
    ;;
esac
if ! command -v mise >/dev/null 2>&1; then
  echo "dstack requires mise; install it, then run: mise --cd <dstack-package-root> install --locked" >&2
  exit 127
fi
tool_version() {
  sed -n "s|^\"$1\" = \"\([^\"]*\)\"$|\1|p" "$root/mise.toml"
}
python_version=$(tool_version python)
beads_version=$(tool_version aqua:gastownhall/beads)
mdbook_version=$(tool_version aqua:rust-lang/mdBook)
if [ -z "$python_version" ] || [ -z "$beads_version" ] || [ -z "$mdbook_version" ]; then
  echo "dstack package runtime configuration is invalid" >&2
  exit 1
fi
export MISE_CONFIG_DIR=/dev/null
for runtime in \
  python@"$python_version" \
  aqua:gastownhall/beads@"$beads_version" \
  aqua:rust-lang/mdBook@"$mdbook_version"
do
  if ! mise --cd "$root" where --locked "$runtime" >/dev/null 2>&1; then
    echo "dstack locked runtime is unavailable: $runtime" >&2
    echo "run: mise --cd <dstack-package-root> install --locked" >&2
    exit 1
  fi
done
export DSTACK_LOCKED_RUNTIME=1
export MISE_EXEC_AUTO_INSTALL=false
exec mise --cd "$root" exec --locked \
  python@"$python_version" \
  aqua:gastownhall/beads@"$beads_version" \
  aqua:rust-lang/mdBook@"$mdbook_version" \
  -- python -S "$script" "$@"
