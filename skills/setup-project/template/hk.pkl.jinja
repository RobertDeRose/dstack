amends "package://github.com/jdx/hk/releases/download/v1.54.1/hk@1.54.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.54.1/hk@1.54.1#/Builtins.pkl"

local commit_message_beads = new Step {
  check =
    #"""
    awk '
      /^# ------------------------ >8 ------------------------/ { exit }
      /^diff --git / { exit }
      /^#/ { next }
      /^(Refs?|Tasks?|Issues?):/ {
        printf "use the canonical Beads: footer instead of: %s\n", $0 > "/dev/stderr"
        failed = 1
      }
      /^Beads:/ {
        beads += 1
        if ($0 !~ /^Beads: [a-z][a-z0-9-]*-[a-z0-9][a-z0-9.-]*(, [a-z][a-z0-9-]*-[a-z0-9][a-z0-9.-]*)*$/) {
          printf "invalid Beads footer: %s\n", $0 > "/dev/stderr"
          failed = 1
        }
      }
      NF { last = $0 }
      END {
        if (beads > 1) {
          print "commit message must contain at most one Beads: footer" > "/dev/stderr"
          failed = 1
        }
        if (beads == 1 && last !~ /^Beads:/) {
          print "Beads: must be the final nonblank line" > "/dev/stderr"
          failed = 1
        }
        exit failed
      }
    ' {{commit_msg_file}}
    """#
}

local commit_message_length = new Step {
  check =
    #"""
    awk '
      /^# ------------------------ >8 ------------------------/ { exit }
      /^diff --git / { exit }
      /^#/ { next }
      {
        line += 1
        limit = line == 1 ? 72 : 100
        if (length($0) > limit) {
          printf "commit message line %d is %d characters; maximum is %d\n", line, length($0), limit > "/dev/stderr"
          failed = 1
        }
      }
      END { exit failed }
    ' {{commit_msg_file}}
    """#
}

local commit_message_scope = new Step {
  check =
    #"""
    awk '
      /^# ------------------------ >8 ------------------------/ { exit }
      /^diff --git / { exit }
      /^#/ { next }
      NF {
        if ($0 ~ /^(feat|fix|perf|refactor)!?: /) {
          print "changelog-visible commit subject must use type(scope): summary" > "/dev/stderr"
          exit 1
        }
        exit 0
      }
    ' {{commit_msg_file}}
    """#
}

local harper_commit_message = (Builtins.harper_commit_message) {
  check =
    #"""
    output=$(mktemp)
    trap 'rm -f "$output"' EXIT
    awk '
      /^# ------------------------ >8 ------------------------/ { exit }
      /^diff --git / { exit }
      /^#/ { next }
      /^Beads: [a-z][a-z0-9-]*-[a-z0-9][a-z0-9.-]*(, [a-z][a-z0-9-]*-[a-z0-9][a-z0-9.-]*)*$/ { next }
      {
        line = $0
        if (!seen_subject && NF) {
          seen_subject = 1
          if (line ~ /^release: v[0-9]+\.[0-9]+\.[0-9]+$/) { next }
          sub(/^[a-z]+(\([^)]+\))?!?: /, "", line)
        }
        print line
      }
    ' {{commit_msg_file}} | harper-cli lint --quiet --no-color --user-dict-path .config/harper-dictionary.txt 2>"$output"
    status=$?
    awk '!/^Note: Using user dictionary at /' "$output" >&2
    exit "$status"
    """#
}

local ruff = new Step {
  glob = List("**/*.py", "**/*.pyi")
  check = "ruff check --force-exclude --config line-length=120 {{ files }}"
  fix = "ruff check --force-exclude --config line-length=120 --fix {{ files }}"
}

local ruff_format = new Step {
  glob = List("**/*.py", "**/*.pyi")
  check_diff = "ruff format --quiet --force-exclude --config line-length=120 --diff {{ files }}"
  fix = "ruff format --quiet --force-exclude --config line-length=120 {{ files }}"
}

local ty = new Step {
  glob = List("**/*.py", "**/*.pyi")
  check = "ty check {{ files }}"
}

local biome = new Step {
  glob = List("**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts")
  check = "biome check --no-errors-on-unmatched {{ files }}"
  fix = "biome check --write --no-errors-on-unmatched {{ files }}"
}

local rustfmt = new Step {
  glob = List("**/*.rs")
  check = "rustfmt --check --edition 2024 {{ files }}"
  fix = "rustfmt --edition 2024 {{ files }}"
}

local linters = new Mapping<String, Step> {
  ["byte_order_marker"] = Builtins.byte_order_marker
  ["check_case_conflict"] = Builtins.check_case_conflict
  ["check_executables_have_shebangs"] = Builtins.check_executables_have_shebangs
  ["check_merge_conflict"] = Builtins.check_merge_conflict
  ["contextlint"] = new Step {
    glob = List("README.md", "docs/**/*.md", "contextlint.config.json")
    check = "contextlint"
  }
  ["detect_private_key"] = Builtins.detect_private_key
  ["docs"] = new Step {
    glob = List("docs/src/**/*.md", "docs/book.toml", "scripts/check-docs.py")
    check = "uv run --no-project python scripts/check-docs.py && mdbook build docs"
  }
  ["fix_smart_quotes"] = Builtins.fix_smart_quotes
  ["markdown-table-formatter"] = new Step {
    glob = List("**/*.md", "**/*.markdown")
    check_diff = "markdown-table-formatter --check {{ files }}"
    fix = "markdown-table-formatter {{ files }}"
  }
  ["mise"] = Builtins.mise
  ["newlines"] = Builtins.newlines
  ["rumdl"] = new Step {
    glob = List("**/*.md", "**/*.markdown")
    check = "rumdl check {{ files }}"
    fix = "rumdl check --fix {{ files }}"
  }
  ["trailing_whitespace"] = Builtins.trailing_whitespace
[% if repository_layout == 'monorepo' %]
[% for package in monorepo_packages %]
[% if 'python' in package.language_profiles %]
  ["ruff-[[ package.slug ]]"] = (ruff) { glob = List("[[ package.path ]]/**/*.py", "[[ package.path ]]/**/*.pyi") }
  ["ruff-format-[[ package.slug ]]"] = (ruff_format) { glob = List("[[ package.path ]]/**/*.py", "[[ package.path ]]/**/*.pyi") }
  ["ty-[[ package.slug ]]"] = (ty) { glob = List("[[ package.path ]]/**/*.py", "[[ package.path ]]/**/*.pyi") }
[% endif %]
[% if 'typescript' in package.language_profiles %]
  ["biome-[[ package.slug ]]"] = (biome) { glob = List("[[ package.path ]]/**/*.ts", "[[ package.path ]]/**/*.tsx", "[[ package.path ]]/**/*.mts", "[[ package.path ]]/**/*.cts") }
[% endif %]
[% if 'rust' in package.language_profiles %]
  ["rustfmt-[[ package.slug ]]"] = (rustfmt) { glob = List("[[ package.path ]]/**/*.rs") }
[% endif %]
[% if 'go' in package.language_profiles %]
  ["goimports-[[ package.slug ]]"] = new Step {
    glob = List("[[ package.path ]]/**/*.go")
    check = "output=$(goimports -l {{ files }}) && test -z \"$output\""
    fix = "goimports -w {{ files }}"
  }
  ["gofumpt-[[ package.slug ]]"] = new Step {
    depends = "goimports-[[ package.slug ]]"
    glob = List("[[ package.path ]]/**/*.go")
    check = "output=$(gofumpt -l {{ files }}) && test -z \"$output\""
    fix = "gofumpt -w {{ files }}"
  }
[% endif %]
[% if 'elixir' in package.language_profiles %]
  ["mix-format-[[ package.slug ]]"] = new Step {
    glob = List("[[ package.path ]]/**/*.ex", "[[ package.path ]]/**/*.exs")
    check = "cd [[ package.path ]] && mix format --check-formatted"
    fix = "cd [[ package.path ]] && mix format"
  }
[% endif %]
[% if 'nix' in package.language_profiles %]
  ["nixfmt-[[ package.slug ]]"] = new Step {
    glob = List("[[ package.path ]]/**/*.nix")
    check = "[ \"$(uname -s)/$(uname -m)\" != Darwin/x86_64 ] || { printf '%s\\n' 'Nix profile does not support macOS x64' >&2; exit 1; }; nixfmt --check {{ files }}"
    fix = "[ \"$(uname -s)/$(uname -m)\" != Darwin/x86_64 ] || { printf '%s\\n' 'Nix profile does not support macOS x64' >&2; exit 1; }; nixfmt {{ files }}"
  }
[% endif %]
[% endfor %]
[% else %]
[% if 'python' in language_profiles %]
  ["ruff"] = ruff
  ["ruff-format"] = ruff_format
  ["ty"] = ty
[% endif %]
[% if 'typescript' in language_profiles %]
  ["biome"] = biome
[% endif %]
[% if 'rust' in language_profiles %]
  ["rustfmt"] = rustfmt
[% endif %]
[% if 'go' in language_profiles %]
  ["goimports"] = new Step { glob = List("**/*.go"); check = "output=$(goimports -l {{ files }}) && test -z \"$output\""; fix = "goimports -w {{ files }}" }
  ["gofumpt"] = new Step { depends = "goimports"; glob = List("**/*.go"); check = "output=$(gofumpt -l {{ files }}) && test -z \"$output\""; fix = "gofumpt -w {{ files }}" }
[% endif %]
[% if 'elixir' in language_profiles %]
  ["mix-format"] = new Step { glob = List("**/*.ex", "**/*.exs"); check = "mix format --check-formatted {{ files }}"; fix = "mix format {{ files }}" }
[% endif %]
[% if 'nix' in language_profiles %]
  ["nixfmt"] = new Step { glob = List("**/*.nix"); check = "[ \"$(uname -s)/$(uname -m)\" != Darwin/x86_64 ] || { printf '%s\\n' 'Nix profile does not support macOS x64' >&2; exit 1; }; nixfmt --check {{ files }}"; fix = "[ \"$(uname -s)/$(uname -m)\" != Darwin/x86_64 ] || { printf '%s\\n' 'Nix profile does not support macOS x64' >&2; exit 1; }; nixfmt {{ files }}" }
[% endif %]
[% endif %]
  ["typos"] = Builtins.typos
}

hooks {
  ["commit-msg"] {
    steps {
      ["cocogitto_commit_msg"] = Builtins.cocogitto_commit_msg
      ["harper_commit_message"] = harper_commit_message
      ["commit_message_beads"] = commit_message_beads
      ["commit_message_length"] = commit_message_length
      ["commit_message_scope"] = commit_message_scope
    }
  }
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["check"] {
    steps = (linters) {
[% if repository_layout == 'single-package' and 'python' in language_profiles %]
      ["pytest"] = new Step {
        glob = List("tests/**/*.py")
        check = "[ ! -f pyproject.toml ] || { uv run python -c 'import pytest' || { printf '%s\\n' 'Python profile requires project-owned pytest' >&2; exit 1; }; uv run pytest; }"
      }
[% endif %]
[% if repository_layout == 'single-package' and 'typescript' in language_profiles %]
      ["vitest"] = new Step {
        glob = List("**/*.test.ts", "**/*.test.tsx", "**/*.test.mts", "**/*.test.cts", "**/*.spec.ts", "**/*.spec.tsx", "**/*.spec.mts", "**/*.spec.cts")
        check = "[ ! -f package.json ] || { aube exec vitest --version >/dev/null || { printf '%s\\n' 'TypeScript profile requires project-owned Vitest' >&2; exit 1; }; aube exec vitest run; }"
      }
[% endif %]
[% if repository_layout == 'single-package' and 'rust' in language_profiles %]
      ["cargo-clippy"] = new Step {
        check = "[ ! -f Cargo.toml ] || cargo clippy --all-targets --all-features -- -D warnings"
      }
      ["cargo-test"] = new Step {
        check = "[ ! -f Cargo.toml ] || cargo test --all-targets --all-features"
      }
[% endif %]
[% if repository_layout == 'single-package' and 'go' in language_profiles %]
      ["go-mod"] = new Step {
        check = "[ ! -f go.mod ] || { go mod tidy -diff && go mod verify; }"
      }
      ["golangci-lint"] = new Step {
        check = "[ ! -f go.mod ] || golangci-lint run"
      }
      ["go-test"] = new Step {
        check = "[ ! -f go.mod ] || go test ./..."
      }
[% endif %]
[% if repository_layout == 'single-package' and 'elixir' in language_profiles %]
      ["mix-compile"] = new Step {
        check = "[ ! -f mix.exs ] || mix compile --warnings-as-errors"
      }
      ["credo"] = new Step {
        check = "[ ! -f mix.exs ] || { mix help credo >/dev/null || { printf '%s\\n' 'Elixir profile requires project-owned Credo' >&2; exit 1; }; mix credo --strict; }"
      }
      ["mix-test"] = new Step {
        glob = List("test/**/*.exs")
        check = "[ ! -f mix.exs ] || mix test --warnings-as-errors"
      }
[% endif %]
[% if repository_layout == 'single-package' and 'nix' in language_profiles %]
      ["nix-flake-check"] = new Step {
        check = "[ ! -f flake.nix ] || { [ \"$(uname -s)/$(uname -m)\" != Darwin/x86_64 ] || { printf '%s\\n' 'Nix profile does not support macOS x64' >&2; exit 1; }; command -v nix >/dev/null || { printf '%s\\n' 'Nix profile requires system nix for flake checks' >&2; exit 1; }; nix flake check; }"
      }
[% endif %]
    }
  }
  ["fix"] {
    fix = true
    steps = (linters) {
[% if repository_layout == 'single-package' and 'go' in language_profiles %]
      ["go-mod"] = new Step {
        depends = "gofumpt"
        check = "[ ! -f go.mod ] || go mod tidy -diff"
        fix = "[ ! -f go.mod ] || go mod tidy"
      }
[% elif repository_layout == 'monorepo' %]
[% for package in monorepo_packages %]
[% if 'go' in package.language_profiles %]
      ["go-mod-[[ package.slug ]]"] = new Step {
        depends = "gofumpt-[[ package.slug ]]"
        glob = List("[[ package.path ]]/**/*.go", "[[ package.path ]]/go.mod", "[[ package.path ]]/go.sum")
        check = "cd [[ package.path ]] && { [ ! -f go.mod ] || go mod tidy -diff; }"
        fix = "cd [[ package.path ]] && { [ ! -f go.mod ] || go mod tidy; }"
      }
[% endif %]
[% endfor %]
[% endif %]
    }
  }
}
